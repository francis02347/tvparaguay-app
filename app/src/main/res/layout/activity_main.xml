<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="12dp"
        android:background="@drawable/header_glass_bg">

        <!-- Título + badge M3U -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📺 Tv Paraguay Mundial"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:letterSpacing="0.01" />

            <TextView
                android:id="@+id/tvM3uBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 M3U"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/badge_bg"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Barra de búsqueda -->
        <EditText
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:hint="Buscar canal..."
            android:textColorHint="#6B7280"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:background="@drawable/search_bg"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <!-- Fila única de Chips de Filtro (Todos | ❤️ | Países | Géneros) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:scrollbars="none"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:id="@+id/filterChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <!-- Botonera del Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnImportM3u"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:layout_marginEnd="6dp"
                android:text="📋  Importar lista M3U"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/btn_gradient_bg"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/btnCheckUpdate"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.9"
                android:text="🔄  Buscar Actualización"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/btn_secondary_bg"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Lista + barra alfabética -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/tvNoResults"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="😕 No se encontraron canales"
                android:textColor="#88FFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- Guía onboarding / tutorial para lista de canales completamente vacía -->
            <LinearLayout
                android:id="@+id/layoutTutorial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:visibility="gone">

                <!-- Flechas y texto llamativo apuntando hacia arriba -->
                <TextView
                    android:id="@+id/tvTutorialArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⬆️  ¡PULSA AQUÍ PARA IMPORTAR CANALES!  ⬆️"
                    android:textColor="#3B82F6"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/tutorial_card_bg"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨ ¡Bienvenido a Tv Paraguay!"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Por políticas de la Google Play Store, la lista inicial está vacía.\n\nSigue estos dos sencillos pasos para activar los canales recomendados:"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1️⃣ Presiona el botón azul de arriba:\n     «📋 Importar lista M3U»\n\n2️⃣ En la siguiente pantalla, elige:\n     «🚀 Cargar Canales Recomendados»"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="4dp"
                        android:gravity="left" />
                </LinearLayout>
            </LinearLayout>

            <!-- Letra flotante al deslizar la barra alfabética -->
            <TextView
                android:id="@+id/tvAlphaPopup"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="42sp"
                android:textStyle="bold"
                android:background="#CC1A1F2E"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Franja táctil alfabética (puntitos, sin texto) -->
        <LinearLayout
            android:id="@+id/alphaBar"
            android:layout_width="20dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone" />

    </LinearLayout>


    <!-- Barra flotante de eliminación (modo selección) -->
    <LinearLayout
        android:id="@+id/deleteBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#CC1A1F2E"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvDeleteCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="0 seleccionados" />

        <Button
            android:id="@+id/btnCancelDelete"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Cancelar"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#334155"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnConfirmDelete"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="🗑 Eliminar"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#B91C1C"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>

</LinearLayout>
