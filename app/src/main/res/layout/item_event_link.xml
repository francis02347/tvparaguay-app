<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardLink"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#131B2E"
    app:strokeWidth="1.2dp"
    app:strokeColor="#2563EB"
    android:focusable="true"
    android:clickable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">

        <!-- Bandera / Emoji de idioma -->
        <TextView
            android:id="@+id/tvLinkFlag"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="🇪🇸"
            android:textSize="22sp" />

        <!-- Idioma y Bitrate -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/tvLinkLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvLinkType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#93C5FD"
                    android:textSize="11sp"
                    android:text="Web Player" />

                <TextView
                    android:id="@+id/tvLinkBitrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Badge de calidad/estabilidad (ej: 95%) -->
        <TextView
            android:id="@+id/tvLinkQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#059669"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:text="95%"
            android:layout_marginEnd="10dp" />

        <!-- Boton Play -->
        <TextView
            android:id="@+id/btnLinkPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶"
            android:textColor="#3B82F6"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
