<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state: dark blue surface with bright blue border -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#1A2238" />
            <stroke android:width="1.5dp" android:color="#3B82F6" />
        </shape>
    </item>
    <!-- Default state: dark gray surface with subtle gray-blue border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#0F1322" />
            <stroke android:width="1dp" android:color="#1F2942" />
        </shape>
    </item>
</selector>
