<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/header_glass_bg">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/white"
                android:contentDescription="Volver" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📋 Importar Lista M3U"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Contador -->
            <TextView
                android:id="@+id/tvChannelCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Canales M3U guardados: 0"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <!-- ══════════════════════════════════════
                 SECCIÓN: CANALES RECOMENDADOS (Sabor Play Store)
            ══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨  Canales Recomendados"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instalá automáticamente la lista de canales recomendada del Sabor Web"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnLoadRecommended"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="🚀  Cargar Canales Recomendados"
                android:textColor="@color/white"
                android:background="@drawable/btn_gradient_bg"
                app:backgroundTint="@null"
                android:layout_marginBottom="20dp" />

            <!-- Divisor -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E293B"
                android:layout_marginBottom="20dp" />

            <!-- ══════════════════════════════════════
                 SECCIÓN: IMPORTAR POR PAÍS
            ══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌍  Importar por país"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tocá un país para importar todos sus canales desde iptv-org"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <!-- Los botones de país se generan aquí dinámicamente -->
            <LinearLayout
                android:id="@+id/countryGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp" />

            <!-- Progreso y estado -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/accent"
                android:visibility="gone"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/white"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- Divisor -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E293B"
                android:layout_marginBottom="20dp" />

            <!-- ══════════════════════════════════════
                 SECCIÓN: IMPORTAR DESDE URL
            ══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐  Importar desde URL"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pegá la URL de cualquier archivo .m3u"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://ejemplo.com/lista.m3u"
                android:textColorHint="#555"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:padding="12dp"
                android:background="@drawable/input_bg"
                android:inputType="textUri"
                android:singleLine="true"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnImportUrl"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="⬇️  Descargar e importar"
                android:textColor="@color/white"
                android:background="@drawable/btn_gradient_bg"
                app:backgroundTint="@null"
                android:layout_marginBottom="20dp" />


            <!-- Divisor -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E293B"
                android:layout_marginBottom="20dp" />

            <!-- ══════════════════════════════════════
                 SECCIÓN: ABRIR ARCHIVO .m3u
            ══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📁  Importar desde archivo"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seleccioná un archivo .m3u o .m3u8 desde tu dispositivo"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnImportFile"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="📁  Elegir archivo .m3u"
                android:textColor="@color/white"
                android:background="@drawable/btn_secondary_bg"
                app:backgroundTint="@null"
                android:layout_marginBottom="20dp" />

            <!-- Divisor -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E293B"
                android:layout_marginBottom="20dp" />

            <!-- ══════════════════════════════════════
                 SECCIÓN: PEGAR CONTENIDO
            ══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋  Pegar contenido M3U"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etPaste"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:hint="#EXTM3U&#10;#EXTINF:-1,Canal Ejemplo&#10;https://..."
                android:textColorHint="#444"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:padding="12dp"
                android:background="@drawable/input_bg"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:layout_marginBottom="10dp"
                android:scrollbars="vertical" />

            <Button
                android:id="@+id/btnImportPaste"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="✅  Procesar lista pegada"
                android:textColor="@color/white"
                android:background="@drawable/btn_secondary_bg"
                app:backgroundTint="@null"
                android:layout_marginBottom="20dp" />

            <!-- Divisor -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E293B"
                android:layout_marginBottom="20dp" />

            <!-- Borrar todo -->
            <Button
                android:id="@+id/btnClear"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="🗑️  Borrar todos los canales M3U"
                android:textColor="@color/white"
                android:background="@drawable/btn_danger_bg"
                app:backgroundTint="@null"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>

    <!-- Contenedor del Spotlight Overlay para guiar el primer inicio -->
    <FrameLayout
        android:id="@+id/layoutSpotlightOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <com.tvpy.app.SpotlightView
            android:id="@+id/spotlightView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/layoutSpotlightContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/ivSpotlightArrow"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/ic_straight_arrow_up"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/tutorial_card_bg"
                android:padding="16dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ Empezá por acá ✨"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Presioná este botón para activar al instante\ntodos los canales recomendados de la app."
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Overlay de Éxito en Pantalla Completa -->
    <FrameLayout
        android:id="@+id/layoutSuccessOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6090F19"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="@drawable/tutorial_card_bg"
            android:elevation="8dp">

            <!-- Checkmark animado o grande -->
            <TextView
                android:id="@+id/tvSuccessIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎉"
                android:textSize="54sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvSuccessTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Importación Exitosa!"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSuccessDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Los canales recomendados se cargaron correctamente."
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminateTint="#3B82F6"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/tvSuccessRedirect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Redirigiendo al inicio..."
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
